<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!--
        历史记录，不会真的执行：这是P1阶段最初的单表设计（id自增），P4.5阶段分片改造成
        policy_0~policy_3四张表、id改成应用层生成的雪花ID（见002-shard-policy-table.xml）。
        这个changeset留在changelog里，就是为了能直接看到这套系统的schema是怎么从
        "一张表、自增主键"演进到"分片、分布式ID"的——本身不会被执行（下面的precondition
        永远不满足，会被Liquibase标记为"已跳过"），旧环境早就执行过的记录也不受影响。
    -->
    <changeSet id="001-create-policy-table" author="claude-code">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="RUN_NEVER">SELECT 'SKIPPED_ON_PURPOSE'</sqlCheck>
        </preConditions>
        <createTable tableName="policy">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="policy_no" type="VARCHAR(32)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_policy_policy_no"/>
            </column>
            <column name="holder_name" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="product_type" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="premium" type="DECIMAL(12,2)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(16)" defaultValue="DRAFT">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex indexName="idx_policy_holder_name" tableName="policy">
            <column name="holder_name"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
